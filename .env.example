# Copy to .env.local (mode 600). Never commit the real file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Presigned uploads and playback. Server-side only -- no NEXT_PUBLIC_ prefix.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Billing (Paddle). PADDLE_API_KEY is the server-side API key from
# Paddle Dashboard -> Developer Tools -> Authentication.
# PADDLE_WEBHOOK_SECRET is the notification destination's secret key
# (Developer Tools -> Notifications) -- WITHOUT it the webhook refuses every
# request, which is deliberate: an unverified webhook is an unauthenticated
# "make me Pro" API. PADDLE_ENVIRONMENT is "sandbox" or "production".
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
PADDLE_ENVIRONMENT=sandbox

# Paddle.js runs client-side, so these are public by design -- a client token
# (not the API key) from the same Authentication page, scoped for browser use.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Service role. Used ONLY by the Paddle webhook, which is the single path that
# may write entitlement. Bypasses RLS -- never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
