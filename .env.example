# Copy to .env.local (mode 600). Never commit the real file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Presigned uploads and playback. Server-side only -- no NEXT_PUBLIC_ prefix.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Billing. STRIPE_SECRET_KEY starts sk_test_ in test mode.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` locally, or the dashboard
# endpoint in production -- WITHOUT it the webhook refuses every request, which
# is deliberate: an unverified webhook is an unauthenticated "make me Pro" API.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Service role. Used ONLY by the Stripe webhook, which is the single path that
# may write entitlement. Bypasses RLS -- never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
